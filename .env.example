# Copy to .env and fill in only what you need. NOTHING here is required for
# paper trading or backtesting.

# --- AI brain (optional) ---
ANTHROPIC_API_KEY=
POLYBOT_AI_BRAIN=false
POLYBOT_AI_MODEL=claude-opus-4-8

# --- Live trading (DANGER: real money). All three gates required. ---
# 1) flip the master switch
POLYBOT_LIVE=false
# 2) type the exact confirmation token
POLYBOT_LIVE_CONFIRM=
# 3) provide your Polygon wallet key (USDC settlement, chain id 137)
POLYMARKET_PRIVATE_KEY=
#
# Wallet type — pick ONE setup:
#   A) MetaMask / exported private key that holds USDC directly (simplest):
#        POLYMARKET_SIGNATURE_TYPE=0   and leave POLYMARKET_FUNDER blank
#   B) Polymarket email/Magic account (funds in your Polymarket proxy wallet):
#        POLYMARKET_SIGNATURE_TYPE=1   POLYMARKET_FUNDER=0xYourPolymarketAddress
#   C) Browser-proxy wallet:
#        POLYMARKET_SIGNATURE_TYPE=2   POLYMARKET_FUNDER=0xYourProxyAddress
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=
# Order time-in-force: FAK (fill-and-kill, recommended for a taker bot) or GTC.
POLYBOT_ORDER_TYPE=FAK
# API creds are auto-derived from your key at startup; only set these to reuse
# existing ones.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Tuning ---
POLYBOT_POLL_INTERVAL=2.0
# Binance market-data host. Default (data-api.binance.vision) is the public
# data endpoint and is not geo-restricted. If you have direct access you may
# set https://api.binance.com instead.
POLYBOT_BINANCE_REST=https://data-api.binance.vision
POLYBOT_BINANCE_WS=wss://data-stream.binance.vision/ws
