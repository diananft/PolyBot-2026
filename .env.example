# Copy to .env and fill in only what you need. NOTHING here is required for
# paper trading or backtesting.

# --- AI brain (optional) ---
ANTHROPIC_API_KEY=
POLYBOT_AI_BRAIN=false
POLYBOT_AI_MODEL=claude-opus-4-8

# --- Live trading (DANGER: real money). All three gates required. ---
# 1) flip the master switch
POLYBOT_LIVE=false
# 2) type the exact confirmation token
POLYBOT_LIVE_CONFIRM=
# 3) provide your Polygon wallet key (USDC settlement, chain id 137)
POLYMARKET_PRIVATE_KEY=
# Optional CLOB API credentials (for authenticated endpoints)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Tuning ---
POLYBOT_POLL_INTERVAL=2.0
